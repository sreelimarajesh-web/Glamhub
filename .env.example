ADMIN_PASSWORD=<strong-admin-password>
ADMIN_SESSION_SECRET=<at-least-32-random-characters>
GOOGLE_OAUTH_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
PORT=3000
