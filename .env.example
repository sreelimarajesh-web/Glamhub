# Copy to .env and replace every placeholder. These values are not credentials.
MONGODB_URI=mongodb+srv://<least-privilege-user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Optional canonical origin; omit to use each deployment request's origin.
PUBLIC_APP_URL=https://<your-zaya-domain>
SESSION_SECRET=<generate-with-openssl-rand-base64-48>
ADMIN_USERNAME=<unique-administrator-username>
ADMIN_PASSWORD=<unique-random-password-at-least-32-characters>
# Google Identity Services web client. See docs/GOOGLE_SIGN_IN.md before enabling.
GOOGLE_AUTH_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=72416329561-c4enbj103esjlb1v7h5fbg6eb0vgi1oc.apps.googleusercontent.com
RATE_LIMIT_STORE_URL=<shared-rate-limit-rest-endpoint>
RATE_LIMIT_STORE_TOKEN=<shared-rate-limit-store-token>
PORT=3000
